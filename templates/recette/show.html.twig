{% extends 'base.html.twig' %}

{% block title %}{{ recette.titre }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>{{ recette.titre }}</h1>
            
            {# Affichage des étoiles de difficulté #}
            <div class="mb-2">
                {{ difficulty_stars(recette.difficulte) }}
                <span class="text-muted">({{ recette.difficulte }})</span>
            </div>
            
            {% if recette.imageName %}
                <img src="{{ asset('uploads/recettes/' ~ recette.imageName) }}" 
                     class="img-fluid rounded mb-4" 
                     alt="{{ recette.titre }}">
            {% else %}
                <div class="bg-secondary text-white rounded mb-4 d-flex align-items-center justify-content-center" 
                     style="height: 300px;">
                    <i class="fas fa-utensils fa-5x"></i>
                </div>
            {% endif %}
            
            <div class="mb-4">
                <span class="badge bg-primary">{{ recette.categorie.nom ?? 'Sans catégorie' }}</span>
            </div>
            
            <h3>📝 Description</h3>
            <p>{{ recette.description }}</p>
            
            <h3>📖 Instructions</h3>
            <p>{{ recette.instructions|nl2br }}</p>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">ℹ️ Informations</h5>
                </div>
                <div class="card-body">
                    <p><strong>⏱️ Préparation :</strong> {{ recette.tempsPreparation|cooking_time_format }}</p>
                    {% if recette.tempsCuisson %}
                        <p><strong>🔥 Cuisson :</strong> {{ recette.tempsCuisson|cooking_time_format }}</p>
                    {% endif %}
                    <p><strong>⏲️ Total :</strong> {{ (recette.tempsPreparation + (recette.tempsCuisson ?? 0))|cooking_time_format }}</p>
                    <p><strong>👥 Personnes :</strong> {{ recette.nbPersonnes }}</p>
                    <p><strong>📅 Créée :</strong> {{ recette.dateCreation|time_ago }}</p>
                    <p><strong>👨‍🍳 Auteur :</strong> {{ recette.auteur.pseudo }}</p>
                </div>
            </div>
        </div>
    </div>
    {# Dans la section des informations, ajoutez : #}
<div class="card mt-3">
    <div class="card-body">
        <div class="text-center">
            {% if recette.id in favorisIds %}
                <a href="{{ path('favoris_retirer', {'id': recette.id}) }}" class="btn btn-warning w-100">
                    <i class="fas fa-star"></i> Retirer des favoris
                </a>
            {% else %}
                <a href="{{ path('favoris_ajouter', {'id': recette.id}) }}" class="btn btn-outline-warning w-100">
                    <i class="far fa-star"></i> Ajouter aux favoris
                </a>
            {% endif %}
        </div>
    </div>
</div>
    <div class="mt-4">
        <a href="{{ path('recette_index') }}" class="btn btn-secondary">← Retour</a>
        
        {% if is_granted('ROLE_CUISINIER') and (app.user == recette.auteur or is_granted('ROLE_ADMIN')) %}
            <a href="{{ path('recette_edit', {'id': recette.id}) }}" class="btn btn-warning">✏️ Modifier</a>
            
            <form action="{{ path('recette_delete', {'id': recette.id}) }}" method="post" style="display: inline-block;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recette.id) }}">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Supprimer cette recette ?')">
                    🗑️ Supprimer
                </button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}