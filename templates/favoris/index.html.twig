{% extends 'base.html.twig' %}

{% block title %}Mes favoris - RecipeHub{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">
        <i class="fas fa-star text-warning"></i> 
        Mes recettes favorites
    </h1>
    
    {% if recettes|length > 0 %}
        <div class="row">
            {% for recette in recettes %}
                <div class="col-md-4 mb-4">
                    <div class="card recipe-card">
                        {% if recette.imageName %}
                            <img src="{{ asset('uploads/recettes/' ~ recette.imageName) }}" 
                                 class="card-img-top" 
                                 alt="{{ recette.titre }}">
                        {% else %}
                            <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" 
                                 style="height: 200px;">
                                <i class="fas fa-utensils fa-3x"></i>
                            </div>
                        {% endif %}
                        
                        <div class="card-body">
                            <h5 class="card-title">{{ recette.titre }}</h5>
                            <p class="card-text">{{ recette.description|slice(0, 100) }}...</p>
                            
                            <div class="mb-2">
                                <span class="badge bg-primary">{{ recette.categorie.nom ?? 'Sans catégorie' }}</span>
                                <span class="badge 
                                    {% if recette.difficulte == 'facile' %}bg-success
                                    {% elseif recette.difficulte == 'moyen' %}bg-warning
                                    {% else %}bg-danger
                                    {% endif %}">
                                    {{ recette.difficulte|upper }}
                                </span>
                            </div>
                            
                            <p class="card-text">
                                <small class="text-muted">
                                    ⏱️ {{ recette.tempsPreparation + (recette.tempsCuisson ?? 0) }} min
                                    👥 {{ recette.nbPersonnes }} pers
                                </small>
                            </p>
                            
                            <div class="d-flex justify-content-between">
                                <a href="{{ path('recette_show', {'id': recette.id}) }}" class="btn btn-primary">
                                    Voir la recette
                                </a>
                                <a href="{{ path('favoris_retirer', {'id': recette.id}) }}" 
                                   class="btn btn-outline-danger"
                                   onclick="return confirm('Retirer cette recette des favoris ?')">
                                    <i class="fas fa-trash"></i> Retirer
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="text-center mt-4">
            <form action="{{ path('favoris_vider') }}" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Vider tous vos favoris ?')">
                    <i class="fas fa-trash-alt"></i> Vider tous les favoris
                </button>
            </form>
        </div>
    {% else %}
        <div class="alert alert-info text-center">
            <i class="fas fa-star fa-2x mb-3"></i>
            <h4>Aucune recette dans vos favoris</h4>
            <p>Ajoutez des recettes aux favoris en cliquant sur le bouton ⭐ dans les pages de détail.</p>
            <a href="{{ path('recette_index') }}" class="btn btn-primary mt-2">
                Découvrir des recettes
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}