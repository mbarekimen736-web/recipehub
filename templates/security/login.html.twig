{% extends 'base.html.twig' %}

{% block body %}
<div style="max-width: 400px; margin: 50px auto; padding: 20px; border: 1px solid #ccc; border-radius: 5px;">
    <h2>Connexion</h2>
    
    {% if error %}
        <div style="color: red; margin-bottom: 10px;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}
    
    <form method="post">
        <div style="margin-bottom: 15px;">
            <label for="username">Email:</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" style="width: 100%; padding: 8px;" required>
        </div>
        
        <div style="margin-bottom: 15px;">
            <label for="password">Mot de passe:</label>
            <input type="password" id="password" name="_password" style="width: 100%; padding: 8px;" required>
        </div>
        
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        
        <button type="submit" style="background: #4CAF50; color: white; padding: 10px 20px; border: none; border-radius: 5px;">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}