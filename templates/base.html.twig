<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}الدمق و الهريسة - Recettes Tunisiennes{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-red: #e74c3c;
            --dark-red: #c0392b;
            --dark: #2c3e50;
        }
        body {
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
        }
        .navbar {
            background: white;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            padding: 15px 0;
        }
        .navbar-brand {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary-red) !important;
            font-family: 'Poppins', sans-serif;
        }
        .navbar-brand i {
            color: var(--primary-red);
        }
        .navbar-brand small {
            font-size: 0.7rem;
            display: block;
            color: #6c757d;
        }
        .nav-link {
            font-weight: 500;
            transition: color 0.3s;
        }
        .nav-link:hover {
            color: var(--primary-red) !important;
        }
        .hero {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                        url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1920');
            background-size: cover;
            background-position: center;
            height: 500px;
            display: flex;
            align-items: center;
            text-align: center;
            color: white;
        }
        .hero h1 {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 20px;
            font-family: 'Poppins', sans-serif;
        }
        .hero h1 i {
            color: #e74c3c;
        }
        .hero p {
            font-size: 1.2rem;
            margin-bottom: 30px;
        }
        .btn-red {
            background: var(--primary-red);
            color: white;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 500;
            transition: all 0.3s;
            border: none;
            display: inline-block;
            text-decoration: none;
        }
        .btn-red:hover {
            background: var(--dark-red);
            transform: scale(1.05);
            color: white;
        }
        .recipe-card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        .recipe-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }
        .recipe-card img {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }
        .footer {
            background: #1a1a2e;
            color: white;
            padding: 50px 0 20px;
            margin-top: 60px;
        }
        .footer a {
            color: #ccc;
            text-decoration: none;
        }
        .footer a:hover {
            color: var(--primary-red);
        }
        .favoris-badge {
            position: absolute;
            top: -8px;
            right: -5px;
            font-size: 0.7rem;
            padding: 2px 6px;
        }
        @media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            .hero { height: 400px; }
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- Header/Navbar -->
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{{ path('homepage') }}">
            <i class="fas fa-pepper-hot me-2"></i> 
            الدمق و الهريسة
            <small>Recettes Tunisiennes</small>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('recette_index') }}">
                        <i class="fas fa-search me-1"></i> Recettes
                    </a>
                </li>
                
                {% if is_granted('ROLE_CUISINIER') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('recette_new') }}">
                            <i class="fas fa-plus-circle me-1"></i> Ajouter
                        </a>
                    </li>
                {% endif %}
                
                <!-- Lien vers les favoris -->
                {% if app.user %}
                    <li class="nav-item position-relative">
                        <a class="nav-link" href="{{ path('favoris_liste') }}">
                            <i class="fas fa-star text-warning me-1"></i> Favoris
                            {% set nbFavoris = app.session.get('favoris')|length %}
                            {% if nbFavoris > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger favoris-badge">
                                    {{ nbFavoris }}
                                </span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
                
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-user me-1"></i> {{ app.user.pseudo }}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('favoris_liste') }}">
                                <i class="fas fa-star text-warning me-2"></i> Mes favoris
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">
                                <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                            </a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">
                            <i class="fas fa-sign-in-alt me-1"></i> Connexion
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn-red ms-2" href="{{ path('app_register') }}" style="padding: 8px 20px;">
                            <i class="fas fa-user-plus me-1"></i> Inscription
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<!-- Hero Section -->
{% block hero %}
<section class="hero">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>
                    <i class="fas fa-pepper-hot"></i> 
                    الدمق و الهريسة
                </h1>
                <p>Découvrez les saveurs authentiques de la cuisine tunisienne</p>
                <a href="{{ path('recette_index') }}" class="btn-red mt-3">
                    Découvrir les recettes <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}

<!-- Flash Messages -->
<div class="container mt-3">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                <i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- Main Content -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h5><i class="fas fa-pepper-hot me-2"></i> الدمق و الهريسة</h5>
                <p>Plateforme de partage de recettes tunisiennes.</p>
                <div class="mt-2">
                    <span class="badge bg-danger">🇹🇳 Tunisie</span>
                    <span class="badge bg-warning ms-2">🌶️ Harissa</span>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <h5>Liens rapides</h5>
                <ul class="list-unstyled">
                    <li><a href="{{ path('recette_index') }}">Toutes les recettes</a></li>
                    {% if is_granted('ROLE_CUISINIER') %}
                        <li><a href="{{ path('recette_new') }}">Ajouter une recette</a></li>
                    {% endif %}
                    <li><a href="{{ path('favoris_liste') }}">Mes favoris</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-4">
                <h5>Suivez-nous</h5>
                <div>
                    <a href="#" class="me-3"><i class="fab fa-facebook fa-2x"></i></a>
                    <a href="#" class="me-3"><i class="fab fa-instagram fa-2x"></i></a>
                    <a href="#"><i class="fab fa-twitter fa-2x"></i></a>
                </div>
            </div>
        </div>
        <hr class="bg-secondary">
        <div class="text-center">
            <small>&copy; 2026 الدمق و الهريسة - Tous droits réservés</small>
            <div class="mt-1">
                <small class="text-muted">"La cuisine tunisienne, un art de vivre"</small>
            </div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const deleteForms = document.querySelectorAll('.delete-form');
        deleteForms.forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Confirmation',
                    text: 'Êtes-vous sûr de vouloir supprimer cette recette ?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e74c3c',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Oui, supprimer',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>